  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError"
      },
      "ApplicationRecord": {
        "properties": {
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "document_type": {
            "$ref": "#/components/schemas/DocumentType",
            "default": "other"
          },
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "fields": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ExtractedField"
            },
            "type": "object",
            "title": "Fields"
          },
          "linked_to_contract": {
            "type": "boolean",
            "title": "Linked To Contract",
            "default": true
          },
          "registration_review_required": {
            "type": "boolean",
            "title": "Registration Review Required",
            "default": false
          },
          "registration_review_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Registration Review Reason"
          }
        },
        "type": "object",
        "title": "ApplicationRecord"
      },
      "AuditEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "actor": {
            "type": "string",
            "enum": [
              "ai",
              "user",
              "system"
            ],
            "title": "Actor"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "step": {
            "type": "string",
            "title": "Step"
          },
          "field_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Id"
          },
          "previous_value": {
            "title": "Previous Value"
          },
          "new_value": {
            "title": "New Value"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "analysis_id",
          "timestamp",
          "actor",
          "action",
          "step",
          "description"
        ],
        "title": "AuditEvent"
      },
      "AuditResponse": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
